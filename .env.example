SECRET_KEY=
DATABASE_URL=
FLASK_ENV=development
PORT=5100

# Google sign-in (required). Create an OAuth "Web application" client in Google
# Cloud Console; its authorized redirect URI must match GOOGLE_REDIRECT_URI
# exactly (https + a domain name; only localhost may use http).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Required in production; optional for local dev (defaults to this server's own
# /auth/google/callback URL, e.g. http://localhost:5100/auth/google/callback).
GOOGLE_REDIRECT_URI=
# Comma-separated Google accounts allowed to use Homebase. This is the ONLY place
# access is granted; remove an address and restart to revoke it immediately.
HOMEBASE_ALLOWED_EMAILS=
# Optional: bearer tokens for remote MCP clients (AI agents) at https://<site>/mcp.
# Comma-separated name:<sha256> entries; generate one with `flask mcp-token <name>`.
# These unlock only the MCP tools, never the website.
HOMEBASE_MCP_TOKENS=

# Optional: enables AI-powered appliance model lookup. Without it, the
# "Look up appliance" button on Add Appliance simply finds nothing.
ANTHROPIC_API_KEY=

# Reminder emails (Phase 2)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
